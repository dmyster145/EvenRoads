{
  "name": "hoppy-roads",
  "version": "1.0.13",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:compile": "rm -rf .test-dist && tsc -p tsconfig.test.json && printf '{\"type\":\"commonjs\"}\\n' > .test-dist/package.json",
    "test:unit": "npm run test:compile && node --test test/unit/*.test.cjs test/stress/*.test.cjs",
    "test": "npm run test:unit",
    "perf:analyze": "node scripts/perf/analyze-log.cjs",
    "perf:baseline": "node scripts/perf/analyze-log.cjs docs/perf/baseline-2026-03-01.log --json docs/perf/baseline-summary.json",
    "perf:compare": "node scripts/perf/compare-summaries.cjs"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.10",
    "@evenrealities/evenhub-simulator": "^0.6.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "even-toolkit": "^1.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.2",
    "tailwind-merge": "^3.5.0"
  }
}
